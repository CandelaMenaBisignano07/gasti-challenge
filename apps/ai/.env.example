OPENAI_API_KEY=

# Mastra storage (libSQL). Accepts:
#   - filesystem path: .gasti/mastra.db, /var/data/gasti.db
#     relative paths resolve against the apps/ai package root
#   - libSQL-native URL: file:./mastra.db, libsql://..., :memory:
# Empty or absent → default .gasti/mastra.db under the apps/ai package root.
DATABASE_FILE=
